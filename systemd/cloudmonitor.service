[Unit]
Description=CloudPulse Monitor Agent
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=mohit
WorkingDirectory=/home/mohit/projects/cloudpulse
EnvironmentFile=/home/mohit/projects/cloudpulse/cloudpulse_dashboard/.env
ExecStart=/home/mohit/projects/cloudpulse/cpp/build/cloud_monitor_agent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
