[Unit]
Description=CloudPulse Dashboard (Flask)
After=network.target

[Service]
Type=simple
User=mohit
WorkingDirectory=/home/mohit/projects/cloudpulse/cloudpulse_dashboard
EnvironmentFile=/home/mohit/projects/cloudpulse/cloudpulse_dashboard/.env
ExecStart=/home/mohit/projects/cloudpulse/venv/bin/python /home/mohit/projects/cloudpulse/cloudpulse_dashboard/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
